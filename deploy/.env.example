# UDAP server settings (deploy/README.md, step 4).
# python3 deploy.py --site <address> creates the real file for you (new_env.py does the same on its own).
# It copies this file to .env, fills in the secrets, and, when n8n runs on this server, the addresses too.
# Never share .env or commit it: it holds the passwords and tokens.

# --- 1. The address people open ---------------------------------------------------------------------------
# The portal needs HTTPS: a browser will not start it on plain http://<IP>.
#   A DNS name that points at this server (udap.example.com): a public certificate, fetched automatically.
#   No DNS name: the server's public IP address (203.0.113.10). The gateway signs its own certificate, so the
#   browser warns once: choose Advanced, then Proceed.
SITE_ADDRESS=

# Public IP addresses or ranges that may open the portal, separated by spaces: for example your office,
# 203.0.113.7/32. Private networks (10.x, 172.16-31.x, 192.168.x) may always connect. Empty = nobody else.
# The portal has no passwords in this configuration, so never open it to everyone (0.0.0.0/0).
ALLOWED_IPS=

# Change these only if another program on this server already uses ports 80 and 443.
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# --- 2. The link with n8n -----------------------------------------------------------------------------------
# Both are written without a "/" at the end. README step 4 has a table of what to enter in each layout.
# They are also written into the workflow copies, so after changing one, run README step 7 again.
#
# How n8n reaches the Platform API, as seen from the n8n server:  http://<this server's private IP>:8000
PLATFORM_API_URL=
# How the Platform API reaches n8n, as seen from this server:  http://<n8n server's private IP>:5678
# or n8n's own address (https://n8n.example.com).
N8N_WEBHOOK_BASE=

# The network address port 8000 is published on, for n8n only.
#   0.0.0.0    n8n is on another server, or runs in Docker on this one (then firewall port 8000, README step 1)
#   127.0.0.1  n8n runs directly on this server, without Docker
API_BIND=0.0.0.0
API_PORT=8000

# --- 3. Secrets: new_env.py fills these in ------------------------------------------------------------------
POSTGRES_PASSWORD=
# n8n's credential for the Platform API ("Authorization: Bearer <token>").
AUTOMATION_DEV_TOKEN=
# What callers must send as X-Webhook-Token to n8n's webhooks: one token per group of webhooks.
N8N_EXTRACTION_WEBHOOK_TOKEN=
N8N_INTAKE_WEBHOOK_TOKEN=
N8N_DATA_PLATFORM_WEBHOOK_TOKEN=

# --- 4. The model (ModelArts Studio MaaS, CN-Hong Kong) -----------------------------------------------------
# "fake" calls no model. To use the real one: paste the API key between the quotes, check it with
#   docker compose run --rm api python -m scripts.check_maas
# then set MAAS_INTEGRATION=real and run:  docker compose up -d
MAAS_INTEGRATION=fake
MAAS_API_KEY=''
# The same three values as backend/.env on the laptop, so the server answers like the demo did.
MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/v2/chat/completions
MAAS_MODEL=deepseek-v4.1-flash-1017
MAAS_THINKING=enabled
