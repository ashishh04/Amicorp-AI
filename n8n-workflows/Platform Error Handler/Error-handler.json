{
  "id": "AmiErrHandler001",
  "name": "Platform error handler",
  "nodes": [
    {"parameters": {}, "id": "91000000-0000-4000-8000-000000000001", "name": "Workflow failed", "type": "n8n-nodes-base.errorTrigger", "typeVersion": 1, "position": [0, 0]},
    {"parameters": {"mode": "manual", "assignments": {"assignments": [{"id": "91000000-0000-4000-8000-0000000000d1", "name": "workflowId", "value": "={{ $json.workflow.id }}", "type": "string"}, {"id": "91000000-0000-4000-8000-0000000000d2", "name": "workflowName", "value": "={{ $json.workflow.name }}", "type": "string"}, {"id": "91000000-0000-4000-8000-0000000000d3", "name": "executionId", "value": "={{ $json.execution ? $json.execution.id : '' }}", "type": "string"}, {"id": "91000000-0000-4000-8000-0000000000d4", "name": "executionUrl", "value": "={{ $json.execution ? $json.execution.url : '' }}", "type": "string"}, {"id": "91000000-0000-4000-8000-0000000000d5", "name": "failedNode", "value": "={{ $json.execution ? $json.execution.lastNodeExecuted : 'trigger' }}", "type": "string"}, {"id": "91000000-0000-4000-8000-0000000000d6", "name": "message", "value": "={{ $json.execution && $json.execution.error ? $json.execution.error.message : ($json.trigger && $json.trigger.error ? $json.trigger.error.message : 'unknown error') }}", "type": "string"}, {"id": "91000000-0000-4000-8000-0000000000d7", "name": "incidentKey", "value": "={{ 'incident:' + ($json.execution && $json.execution.id ? $json.execution.id : $json.workflow.id + ':' + $now.toMillis()) }}", "type": "string"}]}, "options": {}}, "id": "91000000-0000-4000-8000-000000000002", "name": "Normalize error", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [240, 0]},
    {"parameters": {"method": "POST", "url": "={{ $vars.PLATFORM_API_URL }}/v1/incidents", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Idempotency-Key", "value": "={{ $json.incidentKey }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ source: 'n8n', workflowId: $json.workflowId, workflowName: $json.workflowName, executionId: $json.executionId, executionUrl: $json.executionUrl, failedNode: $json.failedNode, message: $json.message }) }}", "options": {"timeout": 30000}}, "id": "91000000-0000-4000-8000-000000000003", "name": "Record incident", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [480, 0], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 5000, "onError": "continueErrorOutput"},
    {"parameters": {"method": "POST", "url": "={{ $vars.PLATFORM_API_URL }}/v1/notifications", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Idempotency-Key", "value": "={{ $('Normalize error').item.json.incidentKey }}:notify"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ audience: 'role:platform-support', incidentId: $json.incidentId, channel: 'teams', event: 'workflow-failed' }) }}", "options": {}}, "id": "91000000-0000-4000-8000-000000000004", "name": "Notify platform support", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [720, -100], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 5000, "onError": "continueErrorOutput"},
    {"parameters": {"method": "POST", "url": "={{ $vars.OPS_ALERT_WEBHOOK_URL }}", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ text: '[Amicorp n8n] Platform API unreachable while reporting a failure. Workflow: ' + $('Normalize error').item.json.workflowName + ' | node: ' + $('Normalize error').item.json.failedNode + ' | error: ' + $('Normalize error').item.json.message + ' | execution: ' + $('Normalize error').item.json.executionUrl }) }}", "options": {"timeout": 15000}}, "id": "91000000-0000-4000-8000-000000000005", "name": "Direct ops alert (fallback)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [960, 120], "retryOnFail": true, "maxTries": 3, "waitBetweenTries": 5000}
  ],
  "connections": {
    "Workflow failed": {"main": [[{"node": "Normalize error", "type": "main", "index": 0}]]},
    "Normalize error": {"main": [[{"node": "Record incident", "type": "main", "index": 0}]]},
    "Record incident": {"main": [[{"node": "Notify platform support", "type": "main", "index": 0}], [{"node": "Direct ops alert (fallback)", "type": "main", "index": 0}]]},
    "Notify platform support": {"main": [[], [{"node": "Direct ops alert (fallback)", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1", "timezone": "Asia/Hong_Kong", "saveDataErrorExecution": "all"}
}
