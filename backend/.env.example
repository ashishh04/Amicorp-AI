# Copy to .env for local development. Never commit .env.
ENVIRONMENT=local
LOG_JSON=false

# The containers from dev/docker-compose.yml (local-only credentials).
DATABASE_URL=postgresql+psycopg://amc:amc_local_only@127.0.0.1:5440/amicorp
REDIS_URL=redis://127.0.0.1:6379/1

# Local only. n8n sends it as "Authorization: Bearer <token>" and gets the Automation role.
# The API refuses to start with it when ENVIRONMENT is anything but local or test.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOMATION_DEV_TOKEN=

# DEV, NPR and PRD use Entra ID instead (decision D-15). ENTRA_API_CLIENT_ID is the API's client ID (GUID).
# ENTRA_TENANT_ID=
# ENTRA_API_CLIENT_ID=
# ENTRA_ALLOWED_CLIENT_IDS=["<portal SPA client ID>", "<n8n automation client ID>"]

# Local only: synthetic data lake, extractor, recommender, write-back and Teams; run the jobs worker inside
# the API process.
INTEGRATIONS=fake
EMBEDDED_WORKER=true

# Extraction calls n8n back here (N8N_WEBHOOK_BASE defaults to http://127.0.0.1:5678), sending this token as
# X-Webhook-Token. Use the "extraction" value from dev/n8n/out/local-secrets.json (setup-n8n-local.ps1).
N8N_EXTRACTION_WEBHOOK_TOKEN=

# ModelArts Studio MaaS, CN-Hong Kong (dev/README.md, section 5). Paste the key from the API Keys page of the
# MaaS console, then check it:  python -m scripts.check_maas
# MAAS_INTEGRATION=real then uses the real model for card recommendations while INTEGRATIONS=fake keeps the
# other systems synthetic. Send it synthetic data only.
MAAS_API_KEY=
# MAAS_INTEGRATION=real
# The defaults, as "API Calling" on the Real-Time Inference page shows them:
# MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
# MAAS_MODEL=deepseek-v4-flash
# MAAS_THINKING=disabled
