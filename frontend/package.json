{
  "name": "portal-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "ng serve --configuration api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:snapshot": "cd ../backend && python -I scripts/export_openapi.py ../frontend/openapi/openapi.json",
    "api:gen": "ng-openapi-gen --config ng-openapi-gen.json",
    "api:check": "node tools/api-drift-check.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\""
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@azure/msal-angular": "^6.2.3",
    "@azure/msal-browser": "^5.25.1",
    "@fontsource/carlito": "^5.3.0",
    "@fontsource/material-icons": "^5.3.0",
    "@ngrx/signals": "^21.1.1",
    "ag-grid-angular": "^36.2.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-enterprise": "^36.2.0",
    "echarts": "^6.1.0",
    "ngx-echarts": "^21.0.0",
    "ngx-extended-pdf-viewer": "^31.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "^1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  }
}
